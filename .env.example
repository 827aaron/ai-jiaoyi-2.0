# 开发用环境变量示例。复制成 .env 后再改，.env 不进仓库。
# 密钥正式环境存在 macOS 钥匙串（setup-keys），这里只作开发时的备用。
# 下面的值全部留空，不要把真 key 写进任何会提交的文件。

# 运行模式：paper（模拟盘）/ testnet / live
JIAOYI_MODE=paper

# 配置文件路径（默认 config/risk.toml、config/app.toml）
JIAOYI_RISK_CONFIG=config/risk.toml
JIAOYI_APP_CONFIG=config/app.toml

# hummingbot-api 地址（本机 Docker，只绑 127.0.0.1）
HUMMINGBOT_API_URL=http://127.0.0.1:8000
HUMMINGBOT_API_USERNAME=
HUMMINGBOT_API_PASSWORD=

# 以下密钥仅开发时用；正式请用 setup-keys 存进钥匙串
BINANCE_API_KEY=
BINANCE_API_SECRET=
JEV_API_KEY=
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FRED_API_KEY=
